# Copy to .env.local (never committed) to turn on the anonymous daily stats
# in `npm run dev` and `npm run build`. Leave unset to play without them.
# Use the PUBLISHABLE key only: it ships to every browser. Never put the
# secret or service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
